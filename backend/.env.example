# Copy to .env for local development. NEVER commit real values or service-account files.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Firebase. On Render use FIREBASE_SERVICE_ACCOUNT_JSON (secret) or a secret file path in
# GOOGLE_APPLICATION_CREDENTIALS. Locally prefer `gcloud auth application-default login`
# or the emulators (FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST).
FIREBASE_PROJECT_ID=demo-nomadmingle
# FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Comma separated explicit origins for browser clients (mobile apps send no Origin). Never use *.
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=1
BODY_LIMIT=32kb
REQUEST_TIMEOUT_MS=15000
CHECK_REVOKED_TOKENS=true
IP_RATE_LIMIT_PER_MIN=300
USER_RATE_LIMIT_PER_MIN=120

# Secret for scheduled job endpoints (POST /api/v1/internal/jobs/*). Leave empty to disable them.
CRON_SECRET=
REMINDER_LEAD_MINUTES=60

# Community limits
NEW_ACCOUNT_AGE_HOURS=72
NEW_ACCOUNT_MSG_LIMIT=5
ESTABLISHED_MSG_LIMIT=20
RATE_WINDOW_MINUTES=10
MESSAGE_MAX_LENGTH=500
DUPLICATE_WINDOW_SECONDS=30
VIOLATION_COOLDOWN_MINUTES=10
VIOLATION_THRESHOLD=3
VIOLATION_MAX_COOLDOWN_MINUTES=1440
VIOLATION_DECAY_HOURS=24
NEW_ACCOUNT_BLOCK_LINKS=true

# Abuse control
MAX_ACTIVE_HOSTED_ACTIVITIES=10
