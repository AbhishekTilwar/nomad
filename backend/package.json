{
  "name": "nomadmingle-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nomad Mingle REST API (Express + Firebase Admin)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "test:emulator": "cd ../firebase && firebase emulators:exec --only auth,firestore --project demo-nomadmingle \"node --test ../backend/test-emulator/smoke.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
